-- ============================================================================
-- MyHype — Schema database (Supabase / PostgreSQL)
-- Step 2 della roadmap §15. Copre tutte le entità del SPEC §1-§8.
-- Da eseguire nel SQL Editor di Supabase una volta sola al primo setup.
-- ============================================================================

-- Estensioni utili (già abilitate di default su Supabase, le rendiamo esplicite)
create extension if not exists "uuid-ossp";
create extension if not exists "pgcrypto";

-- ============================================================================
-- ENUM: tipologie chiuse (Postgres enum — più efficienti di varchar + check)
-- ============================================================================

create type ruolo_utente as enum ('admin','bo','dv','as','tm','pdv','hr');
create type tipo_pdv     as enum ('sinergia','galleria');
create type categoria_pdv as enum ('A','B','C','D');
create type stato_pdv    as enum ('aperto','chiuso');
create type regime_fiscale as enum ('ritenuta_acconto','cococo','p_iva','assunto');
create type stato_collaboratore as enum ('attivo','disattivato');
create type categoria_cliente as enum ('privato','azienda');
create type prodotto as enum ('mobile','fisso','energia');
create type stato_sottoprodotto as enum ('attivo','disattivato');
create type stato_contratto as enum (
  'da_validare','ko_non_validato','validato','ko','gettonato','stornato'
);
create type motivo_ko_non_validato as enum (
  'non_trovato','documenti_non_validi','manca_firma','manca_modulo_avvenuto_contatto'
);
create type motivo_ko as enum (
  'rifiuto_cliente','ko_tecnico','ko_credito','ko_altro'
);

-- ============================================================================
-- 1. UTENTI APPLICATIVI (account)
-- Nota: i venditori NON hanno account (§1.2). Sono in "collaboratori".
-- L'utenza vera e propria arriva da auth.users (Supabase Auth).
-- Qui teniamo solo il profilo applicativo + ruolo.
-- ============================================================================

create table public.utenti (
  id          uuid primary key references auth.users(id) on delete cascade,
  email       text not null unique,
  nome        text not null,
  cognome     text not null,
  ruolo       ruolo_utente not null,
  attivo      boolean not null default true,
  created_at  timestamptz not null default now(),
  updated_at  timestamptz not null default now()
);

-- ============================================================================
-- 2. PUNTI VENDITA (§2)
-- ============================================================================

create table public.pdv (
  id            uuid primary key default uuid_generate_v4(),
  nome          text not null,
  tipo          tipo_pdv not null,
  area          smallint not null check (area between 1 and 4),
  categoria     categoria_pdv not null,
  data_apertura date not null,  -- obbligatoria per calcolo Gara Gallery primi 3 mesi
  stato         stato_pdv not null default 'aperto',
  -- Se associato a un account PdV in utenti (1 account PdV = 1 PdV)
  account_id    uuid references public.utenti(id) on delete set null,
  created_at    timestamptz not null default now(),
  updated_at    timestamptz not null default now()
);

create index idx_pdv_stato on public.pdv(stato);
create index idx_pdv_area  on public.pdv(area);

-- ============================================================================
-- 3. COLLABORATORI (§3)
-- Include venditori e altre figure (TM, AS, DV) con anagrafica completa.
-- Il "ruolo" qui è una stringa libera perché la spec lascia aperto
-- (Venditore / Venditore Senior / …). L'account applicativo è separato.
-- ============================================================================

create table public.collaboratori (
  id              uuid primary key default uuid_generate_v4(),
  nome            text not null,
  cognome         text not null,
  codice_fiscale  text unique,
  data_nascita    date,
  p_iva           text,
  indirizzo       text,
  telefono        text,
  email           text,
  iban            text,
  data_assunzione date,
  regime_fiscale  regime_fiscale,
  ruolo           text not null,             -- Venditore / Venditore Senior / TM / AS / DV ...
  stato           stato_collaboratore not null default 'attivo',
  link_drive      text,                      -- URL cartella Drive esterna
  -- Collegamento opzionale ad account applicativo (TM/AS/DV hanno account, venditori NO)
  account_id      uuid references public.utenti(id) on delete set null,
  created_at      timestamptz not null default now(),
  updated_at      timestamptz not null default now()
);

-- ============================================================================
-- 4. ASSEGNAZIONI PdV ↔ Collaboratori (N:M, cross-area — §1.4)
-- Un PdV ha più venditori / TM / AS; un collaboratore può stare su più PdV.
-- Il "ruolo_nel_pdv" distingue venditore vs TM vs AS vs DV.
-- ============================================================================

create table public.pdv_collaboratori (
  pdv_id          uuid not null references public.pdv(id) on delete cascade,
  collaboratore_id uuid not null references public.collaboratori(id) on delete cascade,
  ruolo_nel_pdv   text not null,  -- 'venditore' | 'tm' | 'as' | 'dv'
  created_at      timestamptz not null default now(),
  primary key (pdv_id, collaboratore_id, ruolo_nel_pdv)
);

create index idx_pdv_coll_pdv  on public.pdv_collaboratori(pdv_id);
create index idx_pdv_coll_coll on public.pdv_collaboratori(collaboratore_id);

-- ============================================================================
-- 5. CLIENTI (§4.1)
-- ============================================================================

create table public.clienti (
  id               uuid primary key default uuid_generate_v4(),
  categoria        categoria_cliente not null,
  nome             text not null,
  cognome          text not null,
  ragione_sociale  text,                       -- solo se azienda
  codice_fiscale   text not null,
  p_iva            text,                       -- solo se azienda
  email            text not null,
  telefono         text not null,
  iban             text not null,
  pod              text,                       -- solo se energia
  pdr              text,                       -- solo se gas/energia (variante)
  -- Nota: codice_contratto è stato spostato sulla tabella contratti
  --       (un cliente può avere più contratti, ognuno col suo codice)
  created_at       timestamptz not null default now(),
  updated_at       timestamptz not null default now()
);

-- Nota: NESSUN unique su CF — i duplicati sono ammessi previo avviso (§4.3)
create index idx_clienti_cf     on public.clienti(codice_fiscale);
create index idx_clienti_piva   on public.clienti(p_iva);

-- ============================================================================
-- 6. PRODOTTI e SOTTOPRODOTTI (§5)
-- I 3 prodotti sono fissi → uso ENUM invece di una tabella anagrafica.
-- I sottoprodotti sono configurabili da Admin/BO.
-- ============================================================================

create table public.sottoprodotti (
  id                uuid primary key default uuid_generate_v4(),
  nome              text not null,
  prodotto_padre    prodotto not null,
  fatturato_azienda integer not null default 0,  -- € interi (no decimali, §0)
  fatturato_pdv     integer not null default 0,  -- € interi
  punti             integer not null default 0,  -- punti normalizzati (§5.4)
  stato             stato_sottoprodotto not null default 'attivo',
  created_at        timestamptz not null default now(),
  updated_at        timestamptz not null default now()
);

create index idx_sottoprodotti_padre on public.sottoprodotti(prodotto_padre);

-- ============================================================================
-- 7. CONTRATTI (§4, §5, §6)
-- ============================================================================

create table public.contratti (
  id                      uuid primary key default uuid_generate_v4(),
  cliente_id              uuid not null references public.clienti(id) on delete restrict,
  pdv_id                  uuid not null references public.pdv(id) on delete restrict,
  venditore_id            uuid references public.collaboratori(id) on delete set null,
  prodotto                prodotto not null,
  data_sottoscrizione     date not null default current_date,   -- "data registrazione" (immutabile, quando è stato inserito nel CRM)
  data_stipula            date not null default current_date,   -- data reale di stipula (obbligatoria, usata per statistiche/classifiche)

  -- Ciclo di vita (§4.5)
  stato                   stato_contratto not null default 'da_validare',
  motivo_ko_non_validato  motivo_ko_non_validato,
  motivo_ko               motivo_ko,
  note_ko                 text,                          -- obbligatorie se motivo_ko='ko_altro'

  -- Mesi competenza (§4.6) — uso date al primo del mese per semplicità
  mese_gettonamento       date,                          -- es. 2026-07-01 per "Lug 2026"
  mese_storno             date,

  -- Snapshot economici al gettonamento (§5.3) — congelano importi
  fatturato_azienda_snap  integer,
  fatturato_pdv_snap      integer,
  punti_snap              integer,

  note                    text,
  note_bo                 text,                          -- note del Back office (lettura tutti, scrittura solo admin/bo via RLS)
  codice_contratto        text,                          -- codice contratto univoco per prodotto (obbligatorio via UI, nullable a DB per compatibilità retroattiva)
  created_at              timestamptz not null default now(),
  updated_at              timestamptz not null default now(),

  -- Vincoli integrità §4.6
  constraint check_storno_dopo_gettonamento
    check (mese_storno is null or (mese_gettonamento is not null and mese_storno >= mese_gettonamento)),
  constraint check_storno_diverso_da_gettonamento
    check (mese_storno is null or mese_storno <> mese_gettonamento)
);

create index idx_contratti_stato      on public.contratti(stato);
create index idx_contratti_pdv        on public.contratti(pdv_id);
create index idx_contratti_venditore  on public.contratti(venditore_id);
create index idx_contratti_cliente    on public.contratti(cliente_id);
create index idx_contratti_prodotto   on public.contratti(prodotto);
create index idx_contratti_data       on public.contratti(data_sottoscrizione);
create index idx_contratti_stipula    on public.contratti(data_stipula);
create index idx_contratti_gettonato  on public.contratti(mese_gettonamento);

-- ============================================================================
-- 8. RIGHE CONTRATTO (sottoprodotti del contratto, §5.4)
-- Un contratto ha fino a 5 sottoprodotti DELLO STESSO prodotto padre.
-- Un sottoprodotto non può apparire 2 volte nello stesso contratto.
-- ============================================================================

create table public.contratto_sottoprodotti (
  contratto_id      uuid not null references public.contratti(id) on delete cascade,
  sottoprodotto_id  uuid not null references public.sottoprodotti(id) on delete restrict,
  created_at        timestamptz not null default now(),
  primary key (contratto_id, sottoprodotto_id)
);

-- ============================================================================
-- 9. TARGET (§7)
-- Target "base" per combinazione Tipo × Categoria (8 combo, §7.2).
-- + override per singolo PdV (§7.2).
-- Ogni "cella" ha 3 valori: mobile, fisso, energia.
-- ============================================================================

create table public.target_base (
  id          uuid primary key default uuid_generate_v4(),
  tipo        tipo_pdv not null,
  categoria   categoria_pdv not null,
  mese        date not null,                  -- primo giorno del mese solare
  target_mobile   integer not null default 0,
  target_fisso    integer not null default 0,
  target_energia  integer not null default 0,
  created_at  timestamptz not null default now(),
  updated_at  timestamptz not null default now(),
  unique (tipo, categoria, mese)
);

create table public.target_pdv_override (
  id          uuid primary key default uuid_generate_v4(),
  pdv_id      uuid not null references public.pdv(id) on delete cascade,
  mese        date not null,
  target_mobile   integer,
  target_fisso    integer,
  target_energia  integer,
  created_at  timestamptz not null default now(),
  updated_at  timestamptz not null default now(),
  unique (pdv_id, mese)
);

-- ============================================================================
-- 10. GARA GALLERY — soglie (§8.2)
-- 6 soglie × 2 tipi = 12 record attivi per volta.
-- Storicizziamo con valid_from / valid_to per permettere modifiche senza
-- alterare il pregresso (§8.8).
-- ============================================================================

create table public.gara_gallery_soglie (
  id          uuid primary key default uuid_generate_v4(),
  tipo        tipo_pdv not null,
  livello     smallint not null check (livello between 1 and 6),
  punti_min   integer not null,
  premio      integer not null,              -- € interi
  valid_from  date not null,                 -- primo del mese da cui vale
  valid_to    date,                          -- null = valida adesso
  created_at  timestamptz not null default now()
);

create index idx_gara_soglie on public.gara_gallery_soglie(tipo, livello, valid_from);

-- ============================================================================
-- 11. NOTIFICHE (§13)
-- Tabella minima per le notifiche in-app.
-- ============================================================================

create table public.notifiche (
  id            uuid primary key default uuid_generate_v4(),
  destinatario  uuid not null references public.utenti(id) on delete cascade,
  titolo        text not null,
  testo         text not null,
  link          text,
  letta         boolean not null default false,
  created_at    timestamptz not null default now()
);

create index idx_notifiche_dest on public.notifiche(destinatario, letta);

-- ============================================================================
-- 12. SIMULATORE PARAMETRI (Simulatore di Sostenibilità — solo Admin)
-- Tabella singleton (1 sola riga, id=1) con i parametri economici di sistema.
-- RLS: solo admin (vedi migration_simulatore_parametrisql).
-- ============================================================================

create table public.simulatore_parametri (
  id integer primary key default 1 check (id = 1),
  perc_mobile      numeric not null default 65,
  perc_fisso       numeric not null default 30,
  perc_energia     numeric not null default 5,
  punti_mobile     numeric not null default 5,
  punti_fisso      numeric not null default 12,
  punti_energia    numeric not null default 5,
  fatt_az_mobile   numeric not null default 35,
  fatt_az_fisso    numeric not null default 165,
  fatt_az_energia  numeric not null default 100,
  fatt_pdv_mobile  numeric not null default 12,
  fatt_pdv_fisso   numeric not null default 45,
  fatt_pdv_energia numeric not null default 15,
  fisso_venditore  numeric not null default 0,
  stipendio_as     numeric not null default 2500,
  stipendio_dv     numeric not null default 5000,
  costo_recruiting numeric not null default 0,
  costo_back_office numeric not null default 0,
  costo_ufficio    numeric not null default 0,
  updated_at  timestamptz not null default now(),
  updated_by  uuid references auth.users(id)
);

-- ============================================================================
-- TRIGGER: aggiornamento automatico updated_at
-- ============================================================================

create or replace function set_updated_at()
returns trigger as $$
begin
  new.updated_at = now();
  return new;
end;
$$ language plpgsql;

do $$
declare t text;
begin
  for t in select unnest(array[
    'utenti','pdv','collaboratori','clienti','sottoprodotti',
    'contratti','target_base','target_pdv_override'
  ])
  loop
    execute format(
      'create trigger trg_%1$s_updated_at before update on public.%1$s
       for each row execute function set_updated_at();', t
    );
  end loop;
end $$;

-- ============================================================================
-- RLS (Row Level Security) — abilitiamo su tutte le tabelle.
-- Le policy specifiche verranno aggiunte nello Step 3 (auth + ruoli).
-- Per adesso: tutte le tabelle sono bloccate — nessuno può leggere/scrivere
-- finché non si è autenticati e le policy non sono definite.
-- ============================================================================

alter table public.utenti                    enable row level security;
alter table public.pdv                       enable row level security;
alter table public.collaboratori             enable row level security;
alter table public.pdv_collaboratori         enable row level security;
alter table public.clienti                   enable row level security;
alter table public.sottoprodotti             enable row level security;
alter table public.contratti                 enable row level security;
alter table public.contratto_sottoprodotti   enable row level security;
alter table public.target_base               enable row level security;
alter table public.target_pdv_override       enable row level security;
alter table public.gara_gallery_soglie       enable row level security;
alter table public.notifiche                 enable row level security;

