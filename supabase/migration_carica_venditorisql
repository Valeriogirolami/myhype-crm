-- Helper: funzione anonima che crea auth user + utenti + collega collaboratore
-- per ogni record da inserire. Mappa per CF del collaboratore.

do $$
declare
  rec record;
  new_uid uuid;
  pwd_hash text;
begin
  -- I 4 account da creare (CF collaboratore → email + ruolo + nome/cognome)
  for rec in
    select * from (values
      ('PLNGCM89M06G999T', 'Giacomo891989@hotmail.com',   'Giacomo', 'Palandri',  'tm'),
      ('TDNMTT96S13F032N', 'matteo.todini@hypesrl.eu',    'Matteo',  'Todini',    'as'),
      ('CHMSMN88D08L182A', 's.chiominto@hypesrl.eu',      'Simone',  'Chiominto', 'as'),
      ('MDDMNL87D30H501Y', 'm.madeddu@hypesrl.eu',        'Manuel',  'Madeddu',   'dv')
    ) as t(cf, email, nome, cognome, ruolo)
  loop
    -- Salto se già esiste un account con quella email
    if exists (select 1 from auth.users where email = rec.email) then
      raise notice 'Skip % — email già presente', rec.email;
      continue;
    end if;

    new_uid := gen_random_uuid();
    pwd_hash := crypt('MyHype2026!', gen_salt('bf'));

    -- 1) auth.users
    insert into auth.users (
      id, instance_id, email, encrypted_password, email_confirmed_at,
      raw_app_meta_data, raw_user_meta_data, aud, role,
      created_at, updated_at
    ) values (
      new_uid,
      '00000000-0000-0000-0000-000000000000',
      rec.email,
      pwd_hash,
      now(),
      '{"provider":"email","providers":["email"]}'::jsonb,
      jsonb_build_object('nome', rec.nome, 'cognome', rec.cognome),
      'authenticated',
      'authenticated',
      now(),
      now()
    );

    -- 2) public.utenti (profilo applicativo)
    insert into public.utenti (id, email, nome, cognome, ruolo, attivo)
    values (new_uid, rec.email, rec.nome, rec.cognome, rec.ruolo::ruolo_utente, true);

    -- 3) Aggancia all'anagrafica collaboratore
    update public.collaboratori
      set account_id = new_uid
      where codice_fiscale = rec.cf;

    raise notice 'Creato account % (ruolo: %)', rec.email, rec.ruolo;
  end loop;
end $$;

