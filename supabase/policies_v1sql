-- ============================================================================
-- MyHype — RLS Policy v1
-- Policy di sicurezza base sulle tabelle (Step 3 della roadmap §15).
--
-- Versione iniziale: permissiva in lettura per tutti gli utenti loggati,
-- scrittura riservata ad admin/bo. Raffineremo le policy per ruolo
-- (AS/TM/PdV scope-based) in uno step successivo (Step 11+).
--
-- Da eseguire UNA VOLTA SOLA nel SQL Editor di Supabase.
-- ============================================================================

-- ----------------------------------------------------------------------------
-- Funzione helper: ritorna il ruolo dell'utente loggato (o null se non loggato)
-- "security definer" le permette di leggere public.utenti anche sotto RLS.
-- "stable" permette al planner di cacharla nella stessa query.
-- ----------------------------------------------------------------------------
create or replace function public.current_user_role()
returns text
language sql
security definer
stable
as $$
  select ruolo::text from public.utenti where id = auth.uid()
$$;

-- Diamo permesso di esecuzione ai ruoli Supabase
grant execute on function public.current_user_role() to anon, authenticated;

-- ============================================================================
-- TABELLA: utenti
-- - Ogni utente può leggere e aggiornare la propria riga
-- - Admin e BO possono leggere/scrivere tutto
-- ============================================================================

-- Self: lettura propria riga
create policy "utenti_self_select"
  on public.utenti for select
  using (id = auth.uid());

-- Self: aggiornamento proprio profilo
create policy "utenti_self_update"
  on public.utenti for update
  using (id = auth.uid())
  with check (id = auth.uid());

-- Admin/BO: tutto (§11)
create policy "utenti_admin_bo_all"
  on public.utenti for all
  using (public.current_user_role() in ('admin','bo'))
  with check (public.current_user_role() in ('admin','bo'));

-- ============================================================================
-- TABELLA: pdv
-- - Tutti i loggati in lettura (lo scope per ruolo lo applichiamo nell'app
--   e raffineremo lato DB in uno step dedicato)
-- - Admin/BO scrivono
-- ============================================================================

create policy "pdv_read_authenticated"
  on public.pdv for select
  using (auth.uid() is not null);

create policy "pdv_write_admin_bo"
  on public.pdv for all
  using (public.current_user_role() in ('admin','bo'))
  with check (public.current_user_role() in ('admin','bo'));

