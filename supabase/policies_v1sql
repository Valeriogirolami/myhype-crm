create policy "contratti_read_authenticated"
  on public.contratti for select
  using (auth.uid() is not null);

create policy "contratti_insert_pdv_bo_admin"
  on public.contratti for insert
  with check (public.current_user_role() in ('admin','bo','pdv'));

create policy "contratti_update_admin_bo"
  on public.contratti for update
  using (public.current_user_role() in ('admin','bo'))
  with check (public.current_user_role() in ('admin','bo'));

create policy "contratti_delete_admin"
  on public.contratti for delete
  using (public.current_user_role() = 'admin');

