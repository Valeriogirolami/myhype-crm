-- ============================================================================
-- MyHype — Migrazione: tabella simulatore_parametri (Simulatore di Sostenibilità)
-- ============================================================================
-- Tabella SINGLETON (1 sola riga, sempre id=1) con i parametri economici di
-- sistema modificabili SOLO dall'Admin. Usata dalla pagina /simulatore.
-- Adattata alle convenzioni del progetto:
--   - riferimento a auth.users(id) per updated_by
--   - RLS basata sulla funzione helper public.current_user_role() (non sub-select)
-- ============================================================================

create table if not exists public.simulatore_parametri (
  id integer primary key default 1 check (id = 1),

  -- Distribuzione produzione (%) — la somma deve essere 100 (validato lato app)
  perc_mobile      numeric not null default 65,
  perc_fisso       numeric not null default 30,
  perc_energia     numeric not null default 5,

  -- Punti medi per contratto
  punti_mobile     numeric not null default 5,
  punti_fisso      numeric not null default 12,
  punti_energia    numeric not null default 5,

  -- Fatturato Azienda medio per contratto (€)
  fatt_az_mobile   numeric not null default 35,
  fatt_az_fisso    numeric not null default 165,
  fatt_az_energia  numeric not null default 100,

  -- Fatturato PdV medio per contratto (€)
  fatt_pdv_mobile  numeric not null default 12,
  fatt_pdv_fisso   numeric not null default 45,
  fatt_pdv_energia numeric not null default 15,

  -- Fisso venditore (€/mese)
  fisso_venditore  numeric not null default 0,

  -- Stipendi manager (€/mese, lordi azienda)
  stipendio_as     numeric not null default 2500,
  stipendio_dv     numeric not null default 5000,

  -- Costi aziendali (€/mese, totale azienda, NON per centro)
  costo_recruiting numeric not null default 0,
  costo_back_office numeric not null default 0,
  costo_ufficio    numeric not null default 0,

  -- Metadati
  updated_at  timestamptz not null default now(),
  updated_by  uuid references auth.users(id)
);

-- Riga unica di default (id=1). Se già presente non fa nulla.
insert into public.simulatore_parametri (id) values (1)
  on conflict (id) do nothing;

-- ----------------------------------------------------------------------------
-- RLS: solo Admin può leggere e scrivere
-- ----------------------------------------------------------------------------
alter table public.simulatore_parametri enable row level security;

drop policy if exists "simulatore_admin_only" on public.simulatore_parametri;
create policy "simulatore_admin_only"
  on public.simulatore_parametri for all
  using (public.current_user_role() = 'admin')
  with check (public.current_user_role() = 'admin');
